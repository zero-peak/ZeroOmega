.page-header
  h2 {{'options_tab_general' | tr}}
section.settings-group
  h3 {{'options_group_networkRequests' | tr}}
  div.checkbox
    label
      input#revert-proxy-changes(type='checkbox' ng-model='options["-monitorWebRequests"]')
      span {{'options_monitorWebRequests' | tr}}
    p.help-block(omega-html="'options_monitorWebRequestsHelp' | tr")
  p
    a.btn.btn-default(href="./popup/network/index.html" role="button" target="_blank")
      span.glyphicon.glyphicon-dashboard
      = ' '
      | {{'Network monitor'}}
    span.help-inline {{'Inspect network traffic'}}
section.settings-group.width-limit
  h3 {{'options_group_proxyActivity' | tr}}
  div.checkbox
    label
      input#proxy-activity-indicator(type='checkbox' ng-model='options["-proxyActivityIndicator"]')
      span {{'options_proxyActivityIndicator' | tr}}
    p.help-block {{'options_proxyActivityIndicatorHelp' | tr}}
  div(ng-show='options["-proxyActivityIndicator"]')
    .form-group
      label(for='proxy-activity-icon-mode') {{'options_proxyActivityIconMode' | tr}}
      select#proxy-activity-icon-mode.form-control.inline-form-control(ng-model='options["-proxyActivityIconMode"]'
        ng-options='mode as (proxyActivityIconModeI18n(mode) | tr) for mode in proxyActivityIconModes')
    .form-group
      label(for='proxy-activity-window') {{'options_proxyActivityWindowSec' | tr}}
      input#proxy-activity-window.form-control.inline-form-control.no-min-width(type='number' min='1' max='300' step='1'
        style='width: 90px !important;'
        ng-model='options["-proxyActivityWindowSec"]'
        ng-required='options["-proxyActivityIndicator"]')
      span.help-inline {{'options_proxyActivityWindowSecUnit' | tr}}
    div.checkbox(ng-show='options["-proxyActivityIconMode"] != "off"')
      label
        input#proxy-activity-subrequests-only(type='checkbox' ng-model='options["-proxyActivitySubrequestsOnly"]')
        span {{'options_proxyActivitySubrequestsOnly' | tr}}
      p.help-block {{'options_proxyActivitySubrequestsOnlyHelp' | tr}}
    div.checkbox
      label
        input#proxy-activity-popup-highlight(type='checkbox' ng-model='options["-proxyActivityPopupHighlight"]')
        span {{'options_proxyActivityPopupHighlight' | tr}}
    .form-group(ng-show='options["-proxyActivityPopupHighlight"]')
      label(for='proxy-activity-scope') {{'options_proxyActivityScope' | tr}}
      select#proxy-activity-scope.form-control.inline-form-control(ng-model='options["-proxyActivityScope"]'
        ng-options='sc as (proxyActivityScopeI18n(sc) | tr) for sc in proxyActivityScopes')
    div.checkbox
      label
        input#proxy-activity-ignore-cache(type='checkbox' ng-model='options["-proxyActivityIgnoreCache"]')
        span {{'options_proxyActivityIgnoreCache' | tr}}
      p.help-block {{'options_proxyActivityIgnoreCacheHelp' | tr}}
section.settings-group.width-limit
  h3 {{'options_downloadOptions' | tr}}
  p.help-block {{'options_downloadOptionsHelp' | tr}}
  .form-group
    label(for='download-interval') {{'options_downloadInterval' | tr}}
    select#download-interval.form-control.inline-form-control(ng-model='options["-downloadInterval"]'
      ng-options='interval as (downloadIntervalI18n(interval) | tr) for interval in downloadIntervals')
section.settings-group.width-limit
  h3 {{'options_group_conflicts' | tr}}
  p {{'options_conflicts_introduction' | tr}}
  p.help-text.text-danger
    span(style='padding: 1px 4px; background: #da4f49; color: #fff; box-shadow: #ccc 1px 1px 1px 1px;') =
    = ' '
    | {{'options_conflicts_lowerPriority' | tr}}
  p.help-text.text-info
    span.glyphicon.glyphicon-info-sign
    = ' '
    span(omega-html="'options_conflicts_higherPriority' | tr:[$profile('systemProfile')]")

  div.checkbox
    label
      input#revert-proxy-changes(type='checkbox' ng-model='options["-showExternalProfile"]')
      span {{'options_showExternalProfile' | tr}}
  p.help-block(omega-html="'options_showExternalProfileHelp' | tr:[$profile('systemProfile'), $profile('externalProfile')]")
